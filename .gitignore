# ================
# Non-code .gitignore
# ================

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Icon?

# Visual Studio / IDE
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
# .vscode is tracked (contains shared interpreter/formatter settings)
*.code-workspace
.idea/


# Build artifacts and intermediate files
bin/
obj/
Debug/
Release/
x64/
build/
out/
*.wav
*.o
*.obj
*.lib
*.exp
*.ilk
*.pdb
*.ipdb
*.iobj
*.dll
*.exe

# Package and installer outputs
*.msi
*.msix
*.msixbundle
*.nupkg
*.recipe
*.zip
*.7z

# Logs, reports, and test results
*.log
TestResults/
coverage/
coverage.xml
*.trx

# Standalone report exports not meant to live in the repo
# (project .md docs -- README, guides, protocol references -- ARE tracked)
*.pdf

# Temporary and backup files
*~
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.rej

# Secrets and environment files
.env
.env.local
secrets/
*.pem
*.key

# Third-party / runtime folders
node_modules/
dist/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# Misc
.vagrant/
packer_cache/
